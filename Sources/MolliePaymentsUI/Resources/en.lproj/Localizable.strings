/* Placeholder for the card-number field, showing the expected digit
   grouping for a generic 16-digit card. */
"card.number.placeholder" = "1234 1234 1234 1234";

/* Placeholder for the card-security-code (CVC/CVV) field. */
"card.cvc.placeholder" = "CVC";

/* Accessibility label for the CVC field. The field intentionally does
   NOT use secure text entry (masking is applied via accessibilityValue
   instead), so this label must not claim "secure entry". */
"card.cvc.accessibilityLabel" = "Security code";

/* Placeholder for the card-expiry field, showing the expected
   month/year format. */
"card.expiry.placeholder" = "MM/YY";

/* Placeholder for the cardholder-name field. */
"card.holder.placeholder" = "Full name on card";

/* Section header above the card-number/expiry/CVC group in the card
   form. */
"card.section.information" = "Card information";

/* Section header above the cardholder-name group in the card form. */
"card.section.holder" = "Card holder";

/* Title of the primary call-to-action button that submits the card
   form. */
"form.payButton.title" = "Pay with card";

/* Validation message shown when the cardholder-name field is empty. */
"validation.cardholder.empty" = "Enter the name on your card.";

/* Validation message shown when the card number has fewer digits than
   any issuer-assigned PAN. */
"validation.number.tooShort" = "Your card number looks too short.";

/* Validation message shown when the card number has more digits than
   any issuer-assigned PAN. */
"validation.number.tooLong" = "Your card number looks too long.";

/* Validation message shown when the card number fails the Luhn
   checksum, i.e. it contains a typo. */
"validation.number.invalid" = "Check your card number for typos.";

/* Validation message shown when the CVC is not 3 or 4 digits long. */
"validation.cvc.wrongLength" = "CVC must be 3 or 4 digits.";

/* Validation message shown when the expiry field doesn't match the
   MM/YY format. */
"validation.expiry.malformed" = "Enter expiry as MM/YY.";

/* Validation message shown when the expiry month is not between 01
   and 12. */
"validation.expiry.monthOutOfRange" = "Expiry month must be between 01 and 12.";

/* Validation message shown when the expiry date is in the past. */
"validation.expiry.pastMonth" = "Expiry date has passed.";

/* Validation message shown when the expiry date is implausibly far in
   the future. */
"validation.expiry.farFuture" = "Check the expiry date.";
