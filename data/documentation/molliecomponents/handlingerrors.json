{"identifier":{"url":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/HandlingErrors","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/build.MollieComponents\/documentation\/MollieComponents"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Every entry point — ","type":"text"},{"isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCheckout","type":"reference"},{"text":"’s ","type":"text"},{"code":"presentCard(from:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"makeCardComponent(onResult:)","type":"codeVoice"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCardComponent","type":"reference"},{"text":" directly — resolves to a single ","type":"text"},{"isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult","type":"reference"},{"text":" with three terminal states:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/completed(_:)","type":"reference"},{"text":" — the payment succeeded; the associated ","type":"text"},{"isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePayment","type":"reference"},{"text":" carries the ","type":"text"},{"code":"sessionToken","type":"codeVoice"},{"text":" you reconcile against your backend.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/failed(_:)","isActive":true,"type":"reference"},{"text":" — the flow ended in a failure, carrying a ","type":"text"},{"code":"MollieError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/cancelled","isActive":true},{"type":"text","text":" — the cardholder dismissed the flow."}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["switch result {","case .completed(let payment):","    \/\/ payment.sessionToken, payment.amount, payment.currency","case .failed(let error):","    \/\/ Inspect error and map to your own localized UI (see the table below)","case .cancelled:","    \/\/ Normal dismissal — not an error","}"],"type":"codeListing"},{"text":"Cancellation is not an error","anchor":"Cancellation-is-not-an-error","type":"heading","level":3},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/cancelled","isActive":true},{"type":"text","text":" is a "},{"type":"strong","inlineContent":[{"type":"text","text":"normal terminal state"}]},{"type":"text","text":", distinct from "},{"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/failed(_:)","isActive":true},{"type":"text","text":". It fires when the cardholder dismisses the sheet, taps cancel, or the presenting context is torn down. Do not surface it as an error, log it as a failure, or retry automatically — treat it the way you would a user backing out of any modal. (The underlying "},{"type":"codeVoice","code":"MollieError"},{"type":"text","text":" cancellation cases listed under "},{"type":"reference","identifier":"#Reserved","isActive":true},{"type":"text","text":" are never delivered to you; cancellation always surfaces here.)"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"errorDescription"},{"type":"text","text":" strings on "},{"type":"codeVoice","code":"MollieError"},{"type":"text","text":" are developer- and log-facing copy. They are not localized for cardholders — map each case to your own UI strings using the table below."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"text":"Merchant-reachable cases","anchor":"Merchant-reachable-cases","type":"heading","level":2},{"inlineContent":[{"text":"The table below covers every ","type":"text"},{"code":"MollieError","type":"codeVoice"},{"text":" case the SDK can deliver in ","type":"text"},{"code":".failed","type":"codeVoice"},{"text":". Case names are shown in code font; the live documentation for each (Option-click in Xcode) lives on the real ","type":"text"},{"code":"MollieError","type":"codeVoice"},{"text":" symbols in the ","type":"text"},{"code":"MollieCore","type":"codeVoice"},{"text":" module.","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Case"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning \/ Cause"}]}],[{"type":"paragraph","inlineContent":[{"text":"Recommended action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".network(URLError)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transport failure before any HTTP response (offline, DNS, TLS, URL-layer timeout). The SDK auto-retries transient transport failures for idempotent reads (GET\/PUT\/DELETE) only; charging POSTs (tokenisation, checkout-attempt creation) surface on the first failure with an indeterminate outcome."}]}],[{"type":"paragraph","inlineContent":[{"text":"Transient. Prompt “check your connection and try again”; inspect ","type":"text"},{"code":"URLError.code","type":"codeVoice"},{"text":" for specifics. Re-presenting starts a fresh attempt — for a charging operation, reconcile server-side first rather than blindly re-charging.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".api(.unauthorized)"},{"type":"text","text":" (401)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bearer "},{"type":"codeVoice","code":"clientToken"},{"type":"text","text":" is missing, expired, or invalid."}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Merchant fix: your backend mints a fresh session and hands the new token to the SDK. Not retryable with the same token."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".api(.forbidden)","type":"codeVoice"},{"text":" (403)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Authenticated but not permitted — wrong profile, payment method not enabled, or test\/live mode mismatch."}]}],[{"type":"paragraph","inlineContent":[{"text":"Configuration fix; refreshing the token won’t help. Verify the profile and mode. Contact support if entitlements look correct.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".api(.notFound)","type":"codeVoice"},{"text":" (404)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Resource missing: the session expired or never existed, or the base URL\/path is wrong."}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm the token is current and the "},{"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieEndpoints","isActive":true},{"type":"text","text":" are correct; otherwise create a new session."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".api(.validationFailed([Violation]))"},{"type":"text","text":" (422)"}]}],[{"type":"paragraph","inlineContent":[{"text":"RFC 7807 field violations — usually bad card input (often rewrapped as ","type":"text"},{"code":".tokenizationFailed","type":"codeVoice"},{"text":").","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Map each "},{"code":"Violation.name","type":"codeVoice"},{"type":"text","text":" to a form field and show its "},{"code":"reason","type":"codeVoice"},{"type":"text","text":" inline. Cardholder-retryable."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".api(.conflict(retryAfter:))"},{"type":"text","text":" (409)"}]}],[{"type":"paragraph","inlineContent":[{"text":"A competing or duplicate operation on the session.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK auto-retries idempotent ops only, honouring "},{"type":"codeVoice","code":"retryAfter"},{"type":"text","text":" when present; a charging POST surfaces immediately (no auto-retry). On a charging operation, reconcile or create a new session rather than re-charging blindly."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".api(.rateLimited(retryAfter:))","type":"codeVoice"},{"text":" (429)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The request was throttled.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The SDK auto-retries idempotent ops only, honouring ","type":"text"},{"code":"retryAfter","type":"codeVoice"},{"text":" (falling back to jittered exponential backoff); a charging POST surfaces immediately. Don’t hard-fail to the cardholder on a 429 from a read — the SDK is already backing off. If it surfaces from a charge, review your call cadence before re-presenting.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".api(.serverError(Int))"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"An unexpected HTTP status (the wrapped "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", e.g. 500\/502\/503)."}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A 5xx is server-classified transient: the SDK auto-retries it with jittered backoff for idempotent ops only. A charging POST is "},{"type":"strong","inlineContent":[{"text":"never","type":"text"}]},{"type":"text","text":" auto-retried on 5xx — the outcome is indeterminate, so it surfaces for server-side reconciliation before any re-charge. An unexpected 4xx is likely an integration issue — contact support with the status code."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidClientToken(reason:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"clientToken","type":"codeVoice"},{"text":" is not valid base64 or its JSON failed to parse.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Integration error: forward the exact "},{"type":"codeVoice","code":"client_access_token"},{"type":"text","text":" verbatim — no re-encoding or truncation — and confirm it was not already consumed. Not retryable."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".timeout(operation:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The polling budget was exhausted, an attempt got stuck, or no terminal event arrived ("},{"type":"codeVoice","code":"operation"},{"type":"text","text":" is one of session-polling, checkout-attempt-polling, checkout-attempt-stuck, card-payment). Outcome is "},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"type":"text","text":"."}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reconcile server-side before re-presenting — do not silently re-charge. Surface “we’re confirming your payment”. The polling budget ("},{"code":"pollingTimeoutSeconds","type":"codeVoice"},{"type":"text","text":") is configurable."}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".sessionFailed(ProblemDetails?)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A backend terminal failure, or the SDK rejected an unsafe 3DS challenge or redirect URL ("},{"code":"title: \"invalid_configuration\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"detail: \"Unsafe 3DS challenge URL\"","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"\"Unsafe redirect URL\"","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}],[{"inlineContent":[{"text":"A genuine decline → read ","type":"text"},{"type":"codeVoice","code":"ProblemDetails.detail"},{"text":"\/","type":"text"},{"type":"codeVoice","code":".title"},{"text":" and suggest another card. For the “Unsafe … URL” variants → a security\/configuration signal; contact support with the session token (the cardholder cannot fix this).","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".tokenizationFailed(reason:underlying:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Card-to-token conversion failed during tokenisation — a validation rewrap, or another error in ","type":"text"},{"type":"codeVoice","code":"underlying"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Usually a mistyped card: show ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" and prompt re-entry. If ","type":"text"},{"code":"underlying","type":"codeVoice"},{"text":" is a network or server error, the tokenisation POST is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" auto-retried (it is a charging op with no server-honoured dedup) and the outcome may be indeterminate — a re-attempt should follow server-side reconciliation rather than a blind re-charge. (","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" is safe to display — the SDK never logs PAN or CVC.)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".threeDSFailed(reason:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"3D Secure did not succeed. See the "},{"type":"codeVoice","code":"ThreeDSFailureReason"},{"type":"text","text":" cases below."}],"type":"paragraph"}],[{"inlineContent":[{"text":"Depends on the reason — see the next table.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidConfiguration(field:reason:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Misuse or an unsupported host state, split by ","type":"text"},{"code":"field","type":"codeVoice"},{"text":". ","type":"text"},{"code":"cardNumber","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"expiry","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"cardholderName","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"cvc","type":"codeVoice"},{"text":" are ","type":"text"},{"inlineContent":[{"text":"cardholder-correctable","type":"text"}],"type":"strong"},{"text":" (show ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" inline). ","type":"text"},{"code":"host","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"scene","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"submit","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"checkoutAttemptToken","type":"codeVoice"},{"text":" are ","type":"text"},{"inlineContent":[{"type":"text","text":"integration bugs"}],"type":"strong"},{"text":" (present from a VC in a window, not while another modal is up; require an active foreground scene; no double-submit). ","type":"text"},{"code":"\"validator\/parser disagreement\"","type":"codeVoice"},{"text":" is an SDK bug.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fix the integration for the host-state fields; show "},{"type":"codeVoice","code":"reason"},{"type":"text","text":" inline for the card-field ones. Report the “validator\/parser disagreement” variant to Mollie."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".unknown(Error)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Unclassified catch-all — in practice where uncaught "},{"code":"DecodingError","type":"codeVoice"},{"type":"text","text":"s land."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Allow one retry. If it persists, capture the wrapped description plus request context and contact support. Engineering should monitor "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":" rates (spikes ≈ contract drift)."}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"3D Secure failures","anchor":"3D-Secure-failures","type":"heading","level":3},{"inlineContent":[{"text":"When ","type":"text"},{"code":".threeDSFailed(reason:)","type":"codeVoice"},{"text":" is delivered, the associated ","type":"text"},{"code":"ThreeDSFailureReason","type":"codeVoice"},{"text":" narrows the cause:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Reason","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning \/ Cause"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Recommended action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".challengeFailed","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The bank rejected authentication — wrong OTP, the banking app wasn’t approved, or the cardholder cancelled the challenge.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cardholder-retryable, or suggest another card."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".sdkError(message:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A WebView or ACS technical failure ("},{"code":"navigation_error_<code>","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"Unsafe navigation blocked\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"timeout\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"3DS error <code>","type":"codeVoice"},{"type":"text","text":", "},{"code":"mollie_error_<code>","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}],[{"inlineContent":[{"text":"Mostly transient → retry. ","type":"text"},{"code":"\"Unsafe navigation blocked\"","type":"codeVoice"},{"text":" is a security signal — contact support. Do not show the raw ","type":"text"},{"code":"message","type":"codeVoice"},{"text":"; map it to a generic “couldn’t complete authentication”.","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Reserved","anchor":"Reserved","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The following cases are "},{"type":"strong","inlineContent":[{"type":"text","text":"declared but never currently emitted"}]},{"type":"text","text":" by the SDK. They exist on the types for forward-compatibility. You do "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" need to write dead "},{"code":"catch","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"switch","type":"codeVoice"},{"type":"text","text":" arms for them — handling the merchant-reachable cases above plus a "},{"code":"default","type":"codeVoice"},{"type":"text","text":" is sufficient:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MollieError.sessionExpired"},{"text":" — session expiry surfaces as ","type":"text"},{"type":"codeVoice","code":".api(.notFound)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".timeout"},{"text":", not this case.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MollieError.sessionCancelled"},{"text":" — cancellation surfaces as ","type":"text"},{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/cancelled","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MollieError.userCancelled","type":"codeVoice"},{"type":"text","text":" — cancellation surfaces as "},{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/cancelled","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MollieError.decoding(DecodingError)"},{"text":" — decode failures currently fall through to ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ThreeDSFailureReason.timeout","type":"codeVoice"},{"text":" — the 3DS timeout path currently uses ","type":"text"},{"code":".sdkError(\"timeout\")","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ThreeDSFailureReason.unknown","type":"codeVoice"},{"text":" — no current code path constructs it.","type":"text"}]}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"These are reserved as documentation only — there is no associated API change. A future SDK release may begin emitting some of them; until then, treat them as unreachable.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"text":"Supporting payload types","anchor":"Supporting-payload-types","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Three supporting types carry the detail you map into merchant UI:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"ProblemDetails","type":"codeVoice"}],"type":"strong"},{"text":" — the RFC 7807 body on ","type":"text"},{"code":".sessionFailed","type":"codeVoice"},{"text":". Inspect ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"detail","type":"codeVoice"},{"text":", ","type":"text"},{"code":"status","type":"codeVoice"},{"text":", ","type":"text"},{"code":"instance","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"extensions","type":"codeVoice"},{"text":". The SDK synthesizes ","type":"text"},{"code":"\"invalid_configuration\"","type":"codeVoice"},{"text":" (with the “Unsafe … URL” detail) for the URL-safety rejections, and falls back to ","type":"text"},{"code":"\"unknown\"","type":"codeVoice"},{"text":" when the server body can’t be parsed.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"Violation"}],"type":"strong"},{"text":" — one per field error inside ","type":"text"},{"code":".api(.validationFailed)","type":"codeVoice"},{"text":". ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" identifies the offending form field; ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" is display-ready copy you can show inline.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".tokenizationFailed.underlying","type":"codeVoice"}]},{"type":"text","text":" — inspect this wrapped error to tell a validation failure (cardholder mistyped) apart from a network or server failure. Tokenisation is a charging POST, so the SDK does not auto-retry it; on a network\/server failure the outcome may be indeterminate, and any re-attempt should follow server-side reconciliation rather than a blind re-charge."}]}]}],"type":"unorderedList"}]}],"kind":"article","variants":[{"paths":["\/documentation\/molliecomponents\/handlingerrors"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"Handling Errors","modules":[{"name":"MollieComponents"}]},"abstract":[{"type":"text","text":"Map every outcome the payment sheet can hand back to merchant-facing behavior."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://build.MollieComponents/documentation/MollieComponents/MollieCheckout":{"navigatorTitle":[{"kind":"identifier","text":"MollieCheckout"}],"abstract":[{"type":"text","text":"Single owner of a checkout’s session context — the client token"},{"type":"text","text":" "},{"type":"text","text":"(both raw and decoded) plus the endpoints it talks to — vended once"},{"type":"text","text":" "},{"type":"text","text":"and reused to present the card form either as a UIKit modal or a"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI component. The host owns presentation in both cases: this"},{"type":"text","text":" "},{"type":"text","text":"type never presents a sheet on its own — "},{"type":"codeVoice","code":"presentCard(from:)"},{"type":"text","text":" "},{"type":"text","text":"presents modally from a host-supplied "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"makeCardComponent(onResult:)"},{"type":"text","text":" vends an embeddable "},{"type":"codeVoice","code":"View"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"host places inside its own layout (including its own "},{"type":"codeVoice","code":".sheet"},{"type":"text","text":", if it"},{"type":"text","text":" "},{"type":"text","text":"wants a modal presentation)."}],"title":"MollieCheckout","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCheckout","url":"\/documentation\/molliecomponents\/molliecheckout","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MollieCheckout"}]},"doc://build.MollieComponents/documentation/MollieComponents/MolliePayment":{"title":"MolliePayment","url":"\/documentation\/molliecomponents\/molliepayment","role":"symbol","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePayment","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MolliePayment"}],"navigatorTitle":[{"kind":"identifier","text":"MolliePayment"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A successfully completed Mollie payment as surfaced to the merchant."}]},"doc://build.MollieComponents/documentation/MollieComponents/MolliePaymentResult":{"t