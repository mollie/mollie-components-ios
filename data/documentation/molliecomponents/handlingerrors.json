:" ","kind":"text"},{"text":"MolliePayment","kind":"identifier"}],"abstract":[{"text":"A successfully completed Mollie payment as surfaced to the merchant.","type":"text"}],"title":"MolliePayment","type":"topic","url":"\/documentation\/molliecomponents\/molliepayment","navigatorTitle":[{"text":"MolliePayment","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePayment"},"doc://mollie-components-2-ios-sdk.MollieComponents/documentation/MollieComponents/MolliePaymentResult/failed(_:)":{"role":"symbol","title":"MolliePaymentResult.failed(_:)","kind":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"failed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MollieError","kind":"typeIdentifier","preciseIdentifier":"s:10MollieCore0A5ErrorO"},{"text":")","kind":"text"}],"url":"\/documentation\/molliecomponents\/molliepaymentresult\/failed(_:)","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/failed(_:)","abstract":[]},"doc://mollie-components-2-ios-sdk.MollieComponents/documentation/MollieComponents/MolliePaymentCardFormView":{"abstract":[{"type":"text","text":"Embeddable SwiftUI surface for the Mollie card form."}],"kind":"symbol","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentCardFormView","navigatorTitle":[{"kind":"identifier","text":"MolliePaymentCardFormView"}],"type":"topic","role":"symbol","url":"\/documentation\/molliecomponents\/molliepaymentcardformview","title":"MolliePaymentCardFormView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MolliePaymentCardFormView","kind":"identifier"}]}}}