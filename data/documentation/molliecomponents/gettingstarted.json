{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Integrating Mollie Components is three steps: add the package, present the sheet from your checkout screen with a server-issued client access token, and switch over the typed "},{"isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult","type":"reference"},{"type":"text","text":" you get back. Card data the cardholder types stays inside Mollie’s UI and is tokenized over TLS — your code only ever sees session metadata."}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The SDK requires iOS 16.0+, Swift 5.9+, and Xcode 16+. It is distributed exclusively via Swift Package Manager.","type":"text"}]}]},{"text":"Add the package","anchor":"Add-the-package","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In your ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"code":[".package(url: \"https:\/\/github.com\/mollie\/mollie-components-ios\", from: \"0.1.0\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or in Xcode: ","type":"text"},{"inlineContent":[{"type":"text","text":"File → Add Package Dependencies…"}],"type":"strong"},{"text":", then paste the repository URL.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Merchants import only the umbrella module:"}]},{"code":["import MollieComponents"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MollieComponents"},{"type":"text","text":" is the only library the package exposes — the entire merchant surface is reachable through it alone."}]},{"text":"Build a checkout","anchor":"Build-a-checkout","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCheckout"},{"text":" owns the session context for a client access token. The SDK never presents its own sheet — you own presentation, either by pushing the card form modally from a ","type":"text"},{"type":"codeVoice","code":"UIViewController"},{"text":", or by embedding ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCardComponent"},{"text":" in your own SwiftUI layout (including your own ","type":"text"},{"type":"codeVoice","code":".sheet"},{"text":", if you want a modal).","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import MollieComponents","","let checkout = try MollieCheckout(clientToken: clientToken)"]},{"type":"paragraph","inlineContent":[{"text":"Construction decodes the token eagerly and throws if it’s malformed, so you can fail fast before presenting anything.","type":"text"}]},{"level":2,"anchor":"Present-modally-UIKit","type":"heading","text":"Present modally (UIKit)"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"presentCard(from:)","type":"codeVoice"},{"text":" with the host view controller and ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" the terminal outcome:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let result = await checkout.presentCard(from: viewController)","","switch result {","case .completed(let payment):","    \/\/ Success — reconcile against your backend using payment.sessionToken","    break","case .failed(let error):","    \/\/ Map the error to merchant-facing UI — see <doc:HandlingErrors>","    break","case .cancelled:","    \/\/ The cardholder dismissed the sheet — not an error","    break","}"]},{"type":"paragraph","inlineContent":[{"text":"The sheet always renders with Mollie’s branded appearance — see ","type":"text"},{"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/Theming","isActive":true},{"text":".","type":"text"}]},{"level":2,"anchor":"Present-inline-SwiftUI","type":"heading","text":"Present inline (SwiftUI)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vend the embeddable form with "},{"type":"codeVoice","code":"makeCardComponent(onResult:)"},{"type":"text","text":" and place it in your own layout — including your own "},{"type":"codeVoice","code":".sheet"},{"type":"text","text":", if you want a modal:"}]},{"syntax":"swift","type":"codeListing","code":["import MollieComponents","import SwiftUI","","struct CheckoutScreen: View {","    @State private var isPaying = false","    let clientToken: String","","    var body: some View {","        Button(\"Pay\") { isPaying = true }","            .sheet(isPresented: $isPaying) {","                if let checkout = try? MollieCheckout(clientToken: clientToken) {","                    checkout.makeCardComponent { result in","                        switch result {","                        case .completed(let payment): break","                        case .failed(let error): break","                        case .cancelled: break","                        }","                        isPaying = false","                    }","                }","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or embed the card form directly in your layout with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCardComponent"},{"type":"text","text":" — no modal, the form’s own “Pay with card” button is the call to action:"}]},{"code":["checkout.makeCardComponent { result in","    \/\/ Same MolliePaymentResult, fired exactly once","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"anchor":"Handle-the-result","text":"Handle the result"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every entry point resolves to the same "},{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/completed(_:)"},{"type":"text","text":" carries a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePayment"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"sessionToken"},{"type":"text","text":" you use to reconcile server-side."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/failed(_:)","type":"reference","isActive":true},{"text":" carries the failure. Map it to your own localized UI — the full catalog of causes and recommended actions is in ","type":"text"},{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/HandlingErrors","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/cancelled"},{"type":"text","text":" means the cardholder dismissed the flow. This is a normal terminal state, "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" an error."}]}]}]},{"type":"heading","level":2,"anchor":"Next-steps","text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/Theming","isActive":true},{"type":"text","text":" — how the sheet’s appearance works."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/HandlingErrors","isActive":true},{"type":"text","text":" — the complete merchant error reference."}]}]}]}]}],"variants":[{"paths":["\/documentation\/molliecomponents\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/GettingStarted"},"abstract":[{"text":"Add the SDK, present a payment surface, and handle the result.","type":"text"}],"sections":[],"seeAlsoSections":[{"anchor":"Getting-Started","identifiers":["doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCheckout"],"title":"Getting Started","generated":true}],"hierarchy":{"paths":[["doc:\/\/build.MollieComponents\/documentation\/MollieComponents"]]},"metadata":{"modules":[{"name":"MollieComponents"}],"role":"article","title":"Getting Started","roleHeading":"Article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://build.MollieComponents/documentation/MollieComponents/MolliePaymentResult":{"url":"\/documentation\/molliecomponents\/molliepaymentresult","kind":"symbol","abstract":[{"type":"text","text":"Terminal outcome of the callback-style entry points —"},{"type":"text","text":" "},{"code":"MollieCheckout.presentCard(from:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MollieCardComponent","type":"codeVoice"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"code":"onResult","type":"codeVoice"},{"type":"text","text":" callback."}],"title":"MolliePaymentResult","type":"topic","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MolliePaymentResult","kind":"identifier"}],"navigatorTitle":[{"te