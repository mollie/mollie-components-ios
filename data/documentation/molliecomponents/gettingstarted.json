{"identifier":{"url":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/GettingStarted","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Getting Started","identifiers":["doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentSheet"],"anchor":"Getting-Started","generated":true}],"abstract":[{"text":"Add the SDK, present a payment surface, and handle the result.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Integrating Mollie Components is three steps: add the package, present the sheet from your checkout screen with a server-issued client access token, and switch over the typed "},{"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult","isActive":true},{"type":"text","text":" you get back. Card data the cardholder types stays inside Mollie’s UI and is tokenized over TLS — your code only ever sees session metadata."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"The SDK requires iOS 16.0+, Swift 5.9+, and Xcode 16+. It is distributed exclusively via Swift Package Manager.","type":"text"}]}],"type":"aside","name":"Note"},{"text":"Add the package","anchor":"Add-the-package","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"In your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/mollie\/mollie-components-ios\", from: \"0.1.0\")"]},{"inlineContent":[{"type":"text","text":"Or in Xcode: "},{"type":"strong","inlineContent":[{"text":"File → Add Package Dependencies…","type":"text"}]},{"type":"text","text":", then paste the repository URL."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Merchants import only the umbrella module:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import MollieComponents"]},{"inlineContent":[{"type":"text","text":"The sub-modules ("},{"type":"codeVoice","code":"MollieCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"MolliePayments"},{"type":"text","text":", "},{"type":"codeVoice","code":"MolliePaymentsUI"},{"type":"text","text":") are available for advanced integrations, but the entire merchant surface is reachable through "},{"type":"codeVoice","code":"MollieComponents"},{"type":"text","text":" alone."}],"type":"paragraph"},{"text":"Present the sheet (UIKit)","anchor":"Present-the-sheet-UIKit","type":"heading","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentSheet","isActive":true},{"type":"text","text":" exposes a single static, "},{"type":"codeVoice","code":"async"},{"type":"text","text":" entry point. Pass the view controller to present from and the client access token your backend minted for this session; "},{"type":"codeVoice","code":"await"},{"type":"text","text":" the terminal outcome:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import MollieComponents","","let result = await MolliePaymentSheet.present(","    from: viewController,","    clientToken: clientToken",")","","switch result {","case .completed(let payment):","    \/\/ Success — reconcile against your backend using payment.sessionToken","    break","case .failed(let error):","    \/\/ Map the error to merchant-facing UI — see <doc:HandlingErrors>","    break","case .cancelled:","    \/\/ The cardholder dismissed the sheet — not an error","    break","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"theme"},{"type":"text","text":" parameter is optional and defaults to Mollie branding. To restyle the sheet, pass a custom theme — see "},{"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/Theming","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Present inline (SwiftUI)","anchor":"Present-inline-SwiftUI","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For SwiftUI hosts you have two options. Use the "},{"type":"codeVoice","code":"molliePaymentSheet(isPresented:clientToken:theme:endpoints:onResult:)"},{"type":"text","text":" modifier to drive a modal from a "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" binding:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import MollieComponents","import SwiftUI","","struct CheckoutScreen: View {","    @State private var isPaying = false","    let clientToken: String","","    var body: some View {","        Button(\"Pay\") { isPaying = true }","            .molliePaymentSheet(isPresented: $isPaying, clientToken: clientToken) { result in","                switch result {","                case .completed(let payment): break","                case .failed(let error): break","                case .cancelled: break","                }","            }","    }","}"]},{"inlineContent":[{"type":"text","text":"Or embed the card form directly in your layout with "},{"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentCardFormView","isActive":true},{"type":"text","text":" — no modal, the form’s own “Pay with card” button is the call to action:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["MolliePaymentCardFormView(clientToken: clientToken) { result in","    \/\/ Same MolliePaymentResult, fired exactly once","}"]},{"text":"Handle the result","anchor":"Handle-the-result","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Every entry point resolves to the same "},{"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/completed(_:)","type":"reference","isActive":true},{"text":" carries a ","type":"text"},{"identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePayment","type":"reference","isActive":true},{"text":" with the ","type":"text"},{"code":"sessionToken","type":"codeVoice"},{"text":" you use to reconcile server-side.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/failed(_:)","type":"reference","isActive":true},{"text":" carries the failure. Map it to your own localized UI — the full catalog of causes and recommended actions is in ","type":"text"},{"identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/HandlingErrors","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/cancelled","type":"reference","isActive":true},{"text":" means the cardholder dismissed the flow. This is a normal terminal state, ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" an error.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Next steps","type":"heading","anchor":"Next-steps","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/Theming"},{"type":"text","text":" — restyle the sheet to match your brand."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/HandlingErrors"},{"type":"text","text":" — the complete merchant error reference."}]}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"metadata":{"title":"Getting Started","role":"article","roleHeading":"Article","modules":[{"name":"MollieComponents"}]},"hierarchy":{"paths":[["doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/molliecomponents\/gettingstarted"]}],"references":{"doc://mollie-components-2-ios-sdk.MollieComponents/documentation/MollieComponents/HandlingErrors":{"role":"article","title":"Handling Errors","abstract":[{"type":"text","text":"Map every outcome the payment sheet can hand back to merchant-facing behavior."}],"type":"topic","url":"\/documentation\/molliecomponents\/handlingerrors","kind":"article","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/HandlingErrors"},"doc://mollie-components-2-ios-sdk.MollieComponents/documentation/MollieComponents/MolliePaymentResult/completed(_:)":{"role":"symbol","title":"MolliePaymentResult.completed(_:)","abstract":[],"type":"topic","url":"\/documentation\/molliecomponents\/molliepaymentresult\/completed(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"completed"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16MollieComponents0A7PaymentV","text":"MolliePayment"},{"kind":"text","text":")"}],"kind":"symbol","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentResult\/com