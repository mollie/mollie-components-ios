{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"There is no public API to customize colors, typography, or corner radius. Every entry point — ","type":"text"},{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCheckout","isActive":true,"type":"reference"},{"text":"’s ","type":"text"},{"code":"presentCard(from:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"makeCardComponent(onResult:)","type":"codeVoice"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCardComponent","isActive":true,"type":"reference"},{"text":" directly — always renders with the same Mollie-branded default theme.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let checkout = try MollieCheckout(clientToken: clientToken)","let result = await checkout.presentCard(from: viewController)"]},{"inlineContent":[{"text":"This is intentional: it keeps the payment surface’s visual trust signals consistent across merchant integrations. If your integration needs a different look, embed ","type":"text"},{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCardComponent","isActive":true,"type":"reference"},{"text":" inside your own layout and style the surrounding chrome — the form itself is not restylable.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The payment sheet always renders with Mollie’s branded appearance.","type":"text"}],"kind":"article","identifier":{"url":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/Theming","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/molliecomponents\/theming"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"MollieComponents"}],"role":"article","roleHeading":"Article","title":"Theming"},"sections":[],"hierarchy":{"paths":[["doc:\/\/build.MollieComponents\/documentation\/MollieComponents"]]},"references":{"doc://build.MollieComponents/documentation/MollieComponents/MollieCardComponent":{"identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCardComponent","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Embeddable SwiftUI surface for the Mollie card form."}],"title":"MollieCardComponent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MollieCardComponent","kind":"identifier"}],"url":"\/documentation\/molliecomponents\/molliecardcomponent","navigatorTitle":[{"text":"MollieCardComponent","kind":"identifier"}],"role":"symbol"},"doc://build.MollieComponents/documentation/MollieComponents":{"title":"MollieComponents","abstract":[{"text":"Accept card payments in your iOS app with a drop-in, PCI-aware payment UI — card tokenization and 3D Secure behind a single import.","type":"text"}],"type":"topic","url":"\/documentation\/molliecomponents","kind":"symbol","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents","role":"collection"},"doc://build.MollieComponents/documentation/MollieComponents/MollieCheckout":{"navigatorTitle":[{"kind":"identifier","text":"MollieCheckout"}],"abstract":[{"type":"text","text":"Single owner of a checkout’s session context — the client token"},{"type":"text","text":" "},{"type":"text","text":"(both raw and decoded) plus the endpoints it talks to — vended once"},{"type":"text","text":" "},{"type":"text","text":"and reused to present the card form either as a UIKit modal or a"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI component. The host owns presentation in both cases: this"},{"type":"text","text":" "},{"type":"text","text":"type never presents a sheet on its own — "},{"type":"codeVoice","code":"presentCard(from:)"},{"type":"text","text":" "},{"type":"text","text":"presents modally from a host-supplied "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"makeCardComponent(onResult:)"},{"type":"text","text":" vends an embeddable "},{"type":"codeVoice","code":"View"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"host places inside its own layout (including its own "},{"type":"codeVoice","code":".sheet"},{"type":"text","text":", if it"},{"type":"text","text":" "},{"type":"text","text":"wants a modal presentation)."}],"title":"MollieCheckout","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCheckout","url":"\/documentation\/molliecomponents\/molliecheckout","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MollieCheckout"}]}}}