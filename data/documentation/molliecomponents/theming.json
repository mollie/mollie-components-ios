oice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"makeCardComponent(onResult:)","type":"codeVoice"},{"text":" vends an embeddable ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"host places inside its own layout (including its own ","type":"text"},{"code":".sheet","type":"codeVoice"},{"text":", if it","type":"text"},{"text":" ","type":"text"},{"text":"wants a modal presentation).","type":"text"}],"kind":"symbol","title":"MollieCheckout","url":"\/documentation\/molliecomponents\/molliecheckout","identifier":"doc:\/\/build.MollieComponents\/documentation\/MollieComponents\/MollieCheckout","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MollieCheckout","kind":"identifier"}],"navigatorTitle":[{"text":"MollieCheckout","kind":"identifier"}],"role":"symbol","type":"topic"}}}