{"identifier":{"url":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/Theming","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Restyle the payment sheet to match your brand."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Every entry point — "},{"type":"reference","identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentSheet","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/mollie-components-2-ios-sdk.MollieComponents\/documentation\/MollieComponents\/MolliePaymentCardFormView","type":"reference","isActive":true},{"text":", and the ","type":"text"},{"code":"molliePaymentSheet(isPresented:clientToken:theme:endpoints:onResult:)","type":"codeVoice"},{"text":" modifier — accepts a ","type":"text"},{"code":"theme","type":"codeVoice"},{"text":" parameter. Omit it and the sheet renders with Mollie-branded defaults; pass a customized ","type":"text"},{"code":"MolliePaymentTheme","type":"codeVoice"},{"text":" to recolor surfaces, retune type sizes, and adjust corner radius.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"MolliePaymentTheme","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", so a theme value can be constructed once and handed across actor boundaries safely.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let theme = MolliePaymentTheme()                 \/\/ Mollie-branded defaults","","let result = await MolliePaymentSheet.present(","    from: viewController,","    clientToken: clientToken,","    theme: theme",")"],"type":"codeListing"},{"inlineContent":[{"text":"A theme has three groups: colors, typography, and corner radius. Each group defaults independently, so you can override just one and inherit the rest.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let theme = MolliePaymentTheme(","    colors: brandColors,","    typography: .default,","    cornerRadius: 12",")"],"type":"codeListing"},{"text":"Colors","level":2,"type":"heading","anchor":"Colors"},{"inlineContent":[{"code":"MolliePaymentTheme.Colors","type":"codeVoice"},{"text":" carries the color tokens applied across the sheet — the pay button, field backgrounds and borders, body text, and the error state. Colors are stored as a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" ","type":"text"},{"code":"ColorValue","type":"codeVoice"},{"text":" (RGBA components) rather than ","type":"text"},{"code":"UIColor","type":"codeVoice"},{"text":", so the theme needs no ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" constraint.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Token","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Where it appears","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"primary","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Pay-button fill and focused-field highlight (defaults to Mollie blue)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onPrimary"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Foreground on top of "},{"code":"primary","type":"codeVoice"},{"text":" — pay-button title, inline spinner label (defaults to white)","type":"text"}]}]],[[{"inlineContent":[{"code":"background","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fill behind the whole sheet content area"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"field","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fill inside each input field (card number, expiry, CVC, cardholder name)","type":"text"}]}]],[[{"inlineContent":[{"code":"fieldBorder","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Stroke around each input field and grouped container"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"text","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Primary text color for field input and body copy"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"error","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Validation error messages and the error state of an invalid field","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"code":"primary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"background","type":"codeVoice"},{"text":", ","type":"text"},{"code":"field","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fieldBorder","type":"codeVoice"},{"text":", ","type":"text"},{"code":"text","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" are required when you build a ","type":"text"},{"code":"Colors","type":"codeVoice"},{"text":" set; ","type":"text"},{"code":"onPrimary","type":"codeVoice"},{"text":" defaults to white so a Mollie-blue button renders correctly out of the box. Lifting ","type":"text"},{"code":"onPrimary","type":"codeVoice"},{"text":" out as its own token lets you supply a light or pastel ","type":"text"},{"code":"primary","type":"codeVoice"},{"text":" and switch the title to a dark color without forking the button view.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let brandColors = MolliePaymentTheme.Colors(","    primary: MolliePaymentTheme.ColorValue(red: 0.10, green: 0.12, blue: 0.88, alpha: 1.0),","    background: MolliePaymentTheme.ColorValue(red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0),","    field: MolliePaymentTheme.ColorValue(red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0),","    fieldBorder: MolliePaymentTheme.ColorValue(red: 0.8, green: 0.8, blue: 0.85, alpha: 1.0),","    text: MolliePaymentTheme.ColorValue(red: 0.08, green: 0.08, blue: 0.12, alpha: 1.0),","    error: MolliePaymentTheme.ColorValue(red: 0.85, green: 0.18, blue: 0.18, alpha: 1.0)",")"],"type":"codeListing"},{"text":"ColorValue and dark mode","level":3,"type":"heading","anchor":"ColorValue-and-dark-mode"},{"inlineContent":[{"code":"MolliePaymentTheme.ColorValue","type":"codeVoice"},{"text":" stores ","type":"text"},{"code":"red","type":"codeVoice"},{"text":", ","type":"text"},{"code":"green","type":"codeVoice"},{"text":", ","type":"text"},{"code":"blue","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"alpha","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" components in the ","type":"text"},{"code":"0","type":"codeVoice"},{"text":"–","type":"text"},{"code":"1","type":"codeVoice"},{"text":" range. ","type":"text"},{"code":"alpha","type":"codeVoice"},{"text":" defaults to ","type":"text"},{"code":"1","type":"codeVoice"},{"text":" (opaque).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each ","type":"text"},{"code":"ColorValue","type":"codeVoice"},{"text":" carries an optional ","type":"text"},{"code":"dark","type":"codeVoice"},{"text":" variant. Supply one and the token resolves to the dark values automatically when the interface is in dark mode; leave it ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and the same values are used in both light and dark.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let adaptiveText = MolliePaymentTheme.ColorValue(","    red: 0.08, green: 0.08, blue: 0.12, alpha: 1.0,","    dark: MolliePaymentTheme.ColorValue(red: 0.95, green: 0.95, blue: 0.97, alpha: 1.0)",")"],"type":"codeListing"},{"text":"Typography","level":2,"type":"heading","anchor":"Typography"},{"inlineContent":[{"code":"MolliePaymentTheme.Typography","type":"codeVoice"},{"text":" sets the point sizes used across the sheet. All sizes are required except ","type":"text"},{"code":"sectionLabelFontSize","type":"codeVoice"},{"text":", which defaults to ","type":"text"},{"code":"15","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Size","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Applies to","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"titleFontSize","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The sheet’s title","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"bodyFontSize","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Body and explanatory copy","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"fieldFontSize","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Text typed into the input fields","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"buttonFontSize","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The pay-button title","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"sectionLabelFontSize","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The “Card information” \/ “Card holder” section headers above each grouped field container","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"syntax":"swift","code":["let typography = MolliePaymentTheme.Typography(","    titleFontSize: 22,","    bodyFontSize: 15,","    fieldFontSize: 17,","    buttonFontSize: 17",")"],"type":"codeListing"},{"text":"Corner radius","level":2,"type":"heading","anchor":"Corner-radius"},{"inlineContent":[{"code":"cornerRadius","type":"codeVoice"},{"text":" is the radius, in points, applied to the pay button and the grouped field containers. It defaults to ","type":"text"},{"code":"10","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let theme = MolliePaymentTheme(cornerRadius: 16)"],"type":"codeListing"}]}],"sections":[],"metadata":{"modules":[{"name":"Mo